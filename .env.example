# Copy to .env.local for the Next.js store and admin portal. Never commit .env.local.

# Address of the URBAN API as the browser sees it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Address the Next.js server uses to reach the API. Defaults to NEXT_PUBLIC_API_URL.
API_URL=

# Allow image optimization from a private address such as localhost.
# Defaults to true in development. Keep false in production unless the API is on a private network.
IMAGES_ALLOW_LOCAL_IP=
