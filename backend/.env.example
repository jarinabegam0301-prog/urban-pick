# Copy to backend/.env on each machine that runs the API. Never commit backend/.env.
#
# Start the API from the backend folder:
#   .venv\Scripts\python.exe -m uvicorn app.main:create_app --factory --port 8000

# PostgreSQL connection. Leave empty to run with in-memory sample data (nothing is saved).
# On the database machine, run backend/schema.sql once, then set this.
DATABASE_URL=

# Signs admin sessions. Required. Use a long random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Hours an admin stays signed in.
SESSION_HOURS=12

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false
# Use "none" (with COOKIE_SECURE=true) only if the API and store are on different sites.
COOKIE_SAMESITE=lax

# Store WhatsApp number with country code. Digits only, for example 919876543210.
WHATSAPP_NUMBER=

# First admin. Created on startup only when no admin exists yet.
# After the first login, change the password in Admin > Settings and you can clear ADMIN_PASSWORD.
ADMIN_EMAIL=admin@urban.com
ADMIN_PASSWORD=
ADMIN_NAME=Urban Admin

# Origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Used for "Today", "This week" and other sales periods.
TIMEZONE=Asia/Kolkata

# Uploaded product images are stored here.
MAX_UPLOAD_MB=5
